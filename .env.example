# LangForge Environment Variables
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://langforge:langforge@localhost:5432/langforge
# For local SQLite (simpler dev setup):
# DATABASE_URL=sqlite:///./langforge.db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LLM APIs (for evaluations + playground) ───────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...   # optional
GOOGLE_API_KEY=...             # optional

# ── Alerts ────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_...

# ── App Settings ──────────────────────────────────────────
APP_NAME=LangForge
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DEBUG=true
